SELECT
sls_prd_key,
COUNT(*)
FROM
(SELECT
pn.prd_id,
pn.sls_prd_key,
pn.prd_nm,
pn.cat_id,
pc.cat,
pc.subcat,
pn.prd_cost,
pn.prd_line,
pn.prd_start_dt,
pc.maintenance
FROM silver.crm_prd_info AS pn
LEFT JOIN silver.erp_px_cat_g1v2 AS pc
ON pn.cat_id = pc.id
WHERE prd_end_dt IS NULL  --FILTER ALL HISTORICAL DATA
)t
GROUP BY sls_prd_key
HAVING COUNT(*)>1


